# FXRP Checkout — Coston2 (testnet) defaults. Copy to .env to override.
# Phase 0 is read-only; no PRIVATE_KEY / XRPL_SEED needed for validation.

FLARE_RPC_URL=https://coston2-api.flare.network/ext/bc/C/rpc
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233

# FDC verifier (Coston2) — optional for Phase 0 live check
# VERIFIER_URL_TESTNET=https://coston2-verifier.api.flare.network/
# VERIFIER_API_KEY_TESTNET=
# COSTON2_DA_LAYER_URL=https://coston2-da-layer.flare.network/
